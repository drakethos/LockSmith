      <_GaleArt Condition="'$(GaleModDeployPath)' != ''">$(GaleModDeployPath)</_GaleArt>
    </PropertyGroup>
    <Delete Files="$(_R2Art)\Assets\drake" Condition="'$(_R2Art)' != '' and Exists('$(_R2Art)\Assets\drake')" />
    <Delete Files="$(_R2Art)\Assets\drake.manifest" Condition="'$(_R2Art)' != '' and Exists('$(_R2Art)\Assets\drake.manifest')" />
    <Delete Files="$(_GaleArt)\Assets\drake" Condition="'$(_GaleArt)' != '' and Exists('$(_GaleArt)\Assets\drake')" />
    <Delete Files="$(_GaleArt)\Assets\drake.manifest" Condition="'$(_GaleArt)' != '' and Exists('$(_GaleArt)\Assets\drake.manifest')" />
  </Target>
  <!-- Test deploy: copy the built DLL into the Gale drakeTest profile (overwrites, no backups). -->
  <Target Name="DeployToGaleDrakeTest" AfterTargets="Build" Condition="'$(GaleModPath)' != '' and '$(ProfileName)' != '' and '$(SkipGaleDeploy)' != 'true'">
    <PropertyGroup>
      <_GaleLockSmithDir>$(GaleModPath)\$(ProfileName)\BepInEx\plugins\DrakeMods-LockSmith</_GaleLockSmithDir>
    </PropertyGroup>
    <MakeDir Directories="$(_GaleLockSmithDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_GaleLockSmithDir)" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Deployed LockSmith -&gt; $(_GaleLockSmithDir)" />
  </Target>
