{
  "name": "PW-07 a ward member keeps full access and may manage",
  "description": "ProtectiveWards integration",
  "steps": [
    {
      "do": "hook",
      "name": "lock.debugMode",
      "args": {
        "on": false
      },
      "expect": false,
      "label": "debug mode (admin override) off: wards treat us like a normal player"
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "place",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "as": "chest"
    },
    {
      "do": "spawn",
      "prefab": "guard_stone",
      "dz": -2,
      "owner": "Alice",
      "enabled": true,
      "radius": 15,
      "as": "ward",
      "permitted": [
        "Bob"
      ]
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "hook",
      "name": "lock.wardAllows",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Bob is on the ward and has access"
    },
    {
      "do": "closeUi"
    },
    {
      "do": "face",
      "target": "chest"
    },
    {
      "do": "interact",
      "target": "chest"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "check",
      "check": "uiVisible",
      "name": "InventoryGui",
      "expect": true,
      "label": "a ward member opens the chest"
    },
    {
      "do": "closeUi"
    },
    {
      "do": "hook",
      "name": "lock.setPublic",
      "args": {
        "target": "chest",
        "on": true
      },
      "expect": true,
      "label": "a ward member can make it public"
    },
    {
      "do": "hook",
      "name": "lock.setPublic",
      "args": {
        "target": "chest",
        "on": false
      },
      "expect": false,
      "label": "and private again"
    },
    {
      "do": "playAs",
      "who": "Carol"
    },
    {
      "do": "closeUi"
    },
    {
      "do": "face",
      "target": "chest"
    },
    {
      "do": "interact",
      "target": "chest"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "check",
      "check": "uiVisible",
      "name": "InventoryGui",
      "expect": false,
      "label": "Carol (not on the ward) is still locked out"
    },
    {
      "do": "closeUi"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "LockSmith"
    }
  ]
}