{
  "name": "AW-08 ward switched off: no protection, no managing",
  "description": "ArcaneWard integration",
  "steps": [
    {
      "do": "hook",
      "name": "lock.debugMode",
      "args": {
        "on": false
      },
      "expect": false,
      "label": "debug mode (admin override) off: wards treat us like a normal player"
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "place",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "as": "chest"
    },
    {
      "do": "hook",
      "name": "lock.spawnArcaneWard",
      "as": "ward",
      "args": {
        "radius": 15,
        "enabled": false,
        "permitted": ""
      }
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "hook",
      "name": "lock.insideWard",
      "args": {
        "target": "chest"
      },
      "expect": false,
      "label": "a switched-off ward does not count as covering"
    },
    {
      "do": "hook",
      "name": "lock.setPublic",
      "args": {
        "target": "chest",
        "on": true
      },
      "expect": false,
      "label": "nothing to manage outside an active ward"
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "closeUi"
    },
    {
      "do": "face",
      "target": "chest"
    },
    {
      "do": "interact",
      "target": "chest"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "check",
      "check": "uiVisible",
      "name": "InventoryGui",
      "expect": true,
      "label": "Bob can open it (the ward is off)"
    },
    {
      "do": "closeUi"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "LockSmith"
    }
  ]
}