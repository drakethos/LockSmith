{
  "name": "LM-02 permissions per person in the menu: Let others on, Switch public / private",
  "description": "",
  "steps": [
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "place",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "dx": 0,
      "as": "chest"
    },
    {
      "do": "spawn",
      "prefab": "guard_stone",
      "dz": -2,
      "owner": "Alice",
      "enabled": true,
      "radius": 15,
      "as": "ward"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "lock.openJoin",
      "args": {
        "target": "chest",
        "on": true
      },
      "expect": true
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "hook",
      "name": "lock.openMenu",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Bob opens the Lock menu",
      "stop": true
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "click",
      "button": "Join access"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "lock.closeMenu"
    },
    {
      "do": "wait",
      "seconds": 0.2
    },
    {
      "do": "hook",
      "name": "lock.isGuest",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Bob is a guest now"
    },
    {
      "do": "hook",
      "name": "lock.canAdd",
      "args": {
        "target": "chest"
      },
      "expect": false,
      "label": "a plain guest cannot let others on"
    },
    {
      "do": "hook",
      "name": "lock.setPublic",
      "args": {
        "target": "chest",
        "on": true
      },
      "expect": false,
      "label": "nor switch public"
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "hook",
      "name": "lock.openMenu",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Alice opens the menu",
      "stop": true
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "click",
      "button": "Bob",
      "label": "click Bob on the piece"
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "check",
      "check": "uiVisible",
      "name": "Let others on",
      "exact": true,
      "expect": true,
      "label": "his permissions open"
    },
    {
      "do": "click",
      "button": "Let others on"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "screenshot",
      "name": "after-let-others-on"
    },
    {
      "do": "hook",
      "name": "lock.guestList",
      "args": {
        "target": "chest"
      },
      "label": "observed right after Let others on (informational)"
    },
    {
      "do": "click",
      "button": "Switch public / private"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "screenshot",
      "name": "after-switch-public"
    },
    {
      "do": "hook",
      "name": "lock.guestList",
      "args": {
        "target": "chest"
      },
      "label": "observed right after Switch public / private (informational)"
    },
    {
      "do": "click",
      "button": "Done"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "lock.closeMenu"
    },
    {
      "do": "wait",
      "seconds": 0.2
    },
    {
      "do": "hook",
      "name": "lock.guestList",
      "args": {
        "target": "chest"
      },
      "contains": "Bob(Add, Toggle)",
      "label": "Bob now has both permissions"
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "hook",
      "name": "lock.canAdd",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Bob may let others on now"
    },
    {
      "do": "hook",
      "name": "lock.setPublic",
      "args": {
        "target": "chest",
        "on": true
      },
      "expect": true,
      "label": "and switch public"
    },
    {
      "do": "hook",
      "name": "lock.setPublic",
      "args": {
        "target": "chest",
        "on": false
      },
      "label": "and private again (informational)"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "LockSmith"
    }
  ]
}