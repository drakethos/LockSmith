{
  "name": "LM-03 Copy people from one chest and Paste them onto another",
  "description": "",
  "steps": [
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "place",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "dx": 0,
      "as": "chest"
    },
    {
      "do": "spawn",
      "prefab": "guard_stone",
      "dz": -2,
      "owner": "Alice",
      "enabled": true,
      "radius": 15,
      "as": "ward"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "place",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "dx": 2.5,
      "as": "chest2"
    },
    {
      "do": "hook",
      "name": "lock.openJoin",
      "args": {
        "target": "chest",
        "on": true
      },
      "expect": true
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "hook",
      "name": "lock.openMenu",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Bob opens the Lock menu",
      "stop": true
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "click",
      "button": "Join access"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "lock.closeMenu"
    },
    {
      "do": "wait",
      "seconds": 0.2
    },
    {
      "do": "hook",
      "name": "lock.isGuest",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Bob is a guest now"
    },
    {
      "do": "playAs",
      "who": "Carol"
    },
    {
      "do": "hook",
      "name": "lock.openMenu",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Carol opens the Lock menu",
      "stop": true
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "click",
      "button": "Join access"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "lock.closeMenu"
    },
    {
      "do": "wait",
      "seconds": 0.2
    },
    {
      "do": "hook",
      "name": "lock.isGuest",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Carol is a guest now"
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "hook",
      "name": "lock.openMenu",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Alice opens the menu on the first chest",
      "stop": true
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "click",
      "button": "Copy people",
      "label": "Copy people (2)"
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "hook",
      "name": "lock.closeMenu"
    },
    {
      "do": "wait",
      "seconds": 0.2
    },
    {
      "do": "hook",
      "name": "lock.clipboard",
      "expect": 2,
      "label": "two people on the clipboard"
    },
    {
      "do": "hook",
      "name": "lock.openMenu",
      "args": {
        "target": "chest2"
      },
      "expect": true,
      "label": "the menu on the second chest",
      "stop": true
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "click",
      "button": "Paste people",
      "label": "Paste people (2)"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "hook",
      "name": "lock.closeMenu"
    },
    {
      "do": "wait",
      "seconds": 0.2
    },
    {
      "do": "hook",
      "name": "lock.guestList",
      "args": {
        "target": "chest2"
      },
      "contains": "Bob",
      "label": "Bob is on the second chest"
    },
    {
      "do": "hook",
      "name": "lock.guestList",
      "args": {
        "target": "chest2"
      },
      "contains": "Carol",
      "label": "and Carol"
    },
    {
      "do": "playAs",
      "who": "Carol"
    },
    {
      "do": "hook",
      "name": "lock.isGuest",
      "args": {
        "target": "chest2"
      },
      "expect": true,
      "label": "Carol counts as a guest there"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "LockSmith"
    }
  ]
}