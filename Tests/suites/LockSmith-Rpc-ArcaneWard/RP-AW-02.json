{
  "name": "RP-AW-02 a forged player id is refused",
  "description": "over the wire, ArcaneWard",
  "steps": [
    {
      "do": "hook",
      "name": "lock.debugMode",
      "args": {
        "on": false
      },
      "expect": false,
      "label": "debug mode (admin override) off: wards treat us like a normal player"
    },
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "place",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "as": "chest"
    },
    {
      "do": "hook",
      "name": "lock.spawnArcaneWard",
      "as": "ward",
      "args": {
        "radius": 15,
        "enabled": true,
        "permitted": ""
      }
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "peerJoin",
      "name": "Bob",
      "dx": 3,
      "dz": 1,
      "as": "bob"
    },
    {
      "do": "check",
      "check": "peerConnected",
      "peer": "Bob",
      "label": "Bob is connected like a second client"
    },
    {
      "do": "peerRpc",
      "peer": "Bob",
      "target": "chest",
      "method": "RPC_LockSmithSetChestPublic",
      "args": [
        1,
        "@Alice"
      ],
      "types": [
        "int",
        "long"
      ],
      "wait": 0.3
    },
    {
      "do": "hook",
      "name": "lock.isPublic",
      "args": {
        "target": "chest"
      },
      "expect": false,
      "label": "Bob claims to be Alice (the ward owner): the sender check refuses it"
    },
    {
      "do": "peerRpc",
      "peer": "Bob",
      "target": "chest",
      "method": "RPC_LockSmithOptInSelf",
      "args": [
        "@Alice",
        "Alice"
      ],
      "types": [
        "long",
        "string"
      ],
      "wait": 0.3
    },
    {
      "do": "hook",
      "name": "lock.isGuest",
      "args": {
        "target": "chest",
        "who": "Alice"
      },
      "expect": false,
      "label": "and cannot put Alice on the list in her name"
    },
    {
      "do": "peerLeave",
      "name": "*"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "LockSmith"
    }
  ]
}