{
  "name": "L-03 strangers cannot make a chest public",
  "description": "",
  "steps": [
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "place",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "as": "chest"
    },
    {
      "do": "spawn",
      "prefab": "guard_stone",
      "dz": -2,
      "owner": "Alice",
      "enabled": true,
      "radius": 15,
      "as": "ward"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "hook",
      "name": "lock.setPublic",
      "args": {
        "target": "chest",
        "on": true
      },
      "expect": false,
      "label": "Bob tries to make it public: refused"
    },
    {
      "do": "closeUi"
    },
    {
      "do": "face",
      "target": "chest"
    },
    {
      "do": "interact",
      "target": "chest"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "check",
      "check": "uiVisible",
      "name": "InventoryGui",
      "expect": false,
      "label": "still locked"
    },
    {
      "do": "closeUi"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "LockSmith"
    }
  ]
}