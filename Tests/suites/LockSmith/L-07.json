{
  "name": "L-07 guests switched off",
  "description": "",
  "steps": [
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "place",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "as": "chest"
    },
    {
      "do": "spawn",
      "prefab": "guard_stone",
      "dz": -2,
      "owner": "Alice",
      "enabled": true,
      "radius": 15,
      "as": "ward"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "lock.openJoin",
      "args": {
        "target": "chest",
        "on": true
      },
      "expect": true
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "hook",
      "name": "lock.openMenu",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "AltPlace+E opens the Lock menu",
      "stop": true
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "click",
      "button": "Join access"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "hook",
      "name": "lock.closeMenu"
    },
    {
      "do": "hook",
      "name": "lock.isGuest",
      "args": {
        "target": "chest"
      },
      "expect": true,
      "label": "Bob joins"
    },
    {
      "do": "setConfig",
      "values": {
        "02 Features/EnablePieceGuests": "false"
      }
    },
    {
      "do": "closeUi"
    },
    {
      "do": "face",
      "target": "chest"
    },
    {
      "do": "interact",
      "target": "chest"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "check",
      "check": "uiVisible",
      "name": "InventoryGui",
      "expect": false,
      "label": "with EnablePieceGuests off a guest is not let in"
    },
    {
      "do": "closeUi"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "LockSmith"
    }
  ]
}