{
  "name": "L-06 Join closed: nobody can join",
  "description": "",
  "steps": [
    {
      "do": "playAs",
      "who": "Alice"
    },
    {
      "do": "place",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "as": "chest"
    },
    {
      "do": "spawn",
      "prefab": "guard_stone",
      "dz": -2,
      "owner": "Alice",
      "enabled": true,
      "radius": 15,
      "as": "ward"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "playAs",
      "who": "Bob"
    },
    {
      "do": "hook",
      "name": "lock.openMenu",
      "args": {
        "target": "chest"
      },
      "label": "AltPlace+E (informational: may open with nothing to do)"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "check",
      "check": "uiVisible",
      "name": "Join access",
      "expect": false,
      "label": "no Join access button is offered"
    },
    {
      "do": "hook",
      "name": "lock.closeMenu"
    },
    {
      "do": "hook",
      "name": "lock.isGuest",
      "args": {
        "target": "chest"
      },
      "expect": false,
      "label": "Join is not open: AltPlace+E does not add Bob"
    },
    {
      "do": "playAs",
      "who": "me"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "LockSmith"
    }
  ]
}